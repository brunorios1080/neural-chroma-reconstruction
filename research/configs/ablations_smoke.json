{
  "manifest": "research/manifests/fixture.jsonl",
  "dataset_root": "research/fixtures/lossless",
  "output_dir": "research/checkpoints/smoke",
  "training": {
    "epochs": 1,
    "batch_size": 2,
    "crop_size": 64,
    "workers": 0,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "seed": 2026,
    "validation_split": "validation"
  },
  "degradations": [
    {
      "name": "center_box_bilinear",
      "siting": "center",
      "downsample_filter": "box",
      "upsample_filter": "bilinear"
    },
    {
      "name": "left_triangle_bilinear",
      "siting": "left",
      "downsample_filter": "triangle",
      "upsample_filter": "bilinear"
    }
  ],
  "experiments": [
    {
      "name": "smoke_base",
      "luma_guidance": true,
      "global_residual": true,
      "block_residual": true,
      "depth": 1,
      "width": 8,
      "loss": "l1"
    },
    {
      "name": "smoke_no_luma",
      "luma_guidance": false,
      "global_residual": true,
      "block_residual": true,
      "depth": 1,
      "width": 8,
      "loss": "l1"
    },
    {
      "name": "smoke_direct",
      "luma_guidance": true,
      "global_residual": false,
      "block_residual": true,
      "depth": 1,
      "width": 8,
      "loss": "charbonnier"
    },
    {
      "name": "smoke_srcnn",
      "architecture": "srcnn",
      "luma_guidance": true,
      "global_residual": true,
      "block_residual": true,
      "depth": 3,
      "width": 8,
      "loss": "l1"
    },
    {
      "name": "smoke_naf_style",
      "architecture": "naf_style",
      "luma_guidance": true,
      "global_residual": true,
      "block_residual": true,
      "depth": 1,
      "width": 8,
      "loss": "l1"
    }
  ]
}

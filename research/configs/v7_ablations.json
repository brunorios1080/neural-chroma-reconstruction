{
  "manifest": "research/manifests/lossless_full.jsonl",
  "dataset_root": "data/research_lossless",
  "output_dir": "research/checkpoints/v7/ablations",
  "model": {"width": 64, "depth": 8, "neutral_chroma": 0.5},
  "loss": {
    "lambda_cart": 1.0,
    "lambda_amplitude": 0.1,
    "lambda_phase": 0.05,
    "lambda_forward": 0.0,
    "phase_reference_amplitude": 0.05,
    "probabilistic": true
  },
  "training": {
    "crop_size": 256,
    "batch_size": 16,
    "epochs": 30,
    "workers": 4,
    "learning_rate": 1e-4,
    "weight_decay": 1e-4,
    "gradient_clip_norm": 0.0,
    "seed": 2026,
    "device": "auto",
    "amp": false
  },
  "degradations": [
    {"name": "center_box_bilinear", "siting": "center", "downsample_filter": "box", "upsample_filter": "bilinear"},
    {"name": "center_triangle_bilinear", "siting": "center", "downsample_filter": "triangle", "upsample_filter": "bilinear"},
    {"name": "center_gaussian_bilinear", "siting": "center", "downsample_filter": "gaussian", "upsample_filter": "bilinear"},
    {"name": "center_lanczos3_bilinear", "siting": "center", "downsample_filter": "lanczos3", "upsample_filter": "bilinear"},
    {"name": "left_box_bilinear", "siting": "left", "downsample_filter": "box", "upsample_filter": "bilinear"},
    {"name": "left_triangle_bilinear", "siting": "left", "downsample_filter": "triangle", "upsample_filter": "bilinear"},
    {"name": "left_gaussian_bilinear", "siting": "left", "downsample_filter": "gaussian", "upsample_filter": "bilinear"},
    {"name": "left_lanczos3_bilinear", "siting": "left", "downsample_filter": "lanczos3", "upsample_filter": "bilinear"},
    {"name": "cosited_box_bilinear", "siting": "cosited", "downsample_filter": "box", "upsample_filter": "bilinear"},
    {"name": "cosited_triangle_bilinear", "siting": "cosited", "downsample_filter": "triangle", "upsample_filter": "bilinear"},
    {"name": "cosited_gaussian_bilinear", "siting": "cosited", "downsample_filter": "gaussian", "upsample_filter": "bilinear"},
    {"name": "cosited_lanczos3_bilinear", "siting": "cosited", "downsample_filter": "lanczos3", "upsample_filter": "bilinear"}
  ],
  "controls": [
    {
      "name": "v6_cartesian_deterministic",
      "ablation": {
        "architecture": "residual",
        "luma_guidance": true,
        "global_residual": true,
        "block_residual": true,
        "depth": 8,
        "width": 64,
        "loss": "l1"
      }
    }
  ],
  "experiments": [
    {
      "name": "v7_polar_deterministic",
      "loss": {"probabilistic": false, "lambda_amplitude": 0.0, "lambda_phase": 0.0, "lambda_forward": 0.0}
    },
    {
      "name": "v7_probabilistic",
      "loss": {"probabilistic": true, "lambda_forward": 0.0}
    },
    {
      "name": "v7_probabilistic_forward",
      "loss": {"probabilistic": true, "lambda_forward": 0.1}
    }
  ],
  "inference_variants": [
    {
      "name": "v7_probabilistic_safe",
      "source_experiment": "v7_probabilistic",
      "mode": "safe",
      "additional_training": false
    }
  ],
  "second_stage_variants": [
    {
      "name": "v7_self_train",
      "config": "research/configs/v7_self_train.json",
      "enabled_by_default": false
    }
  ]
}
